{
  "id": null,
  "uid": "api-mk-octadesk",
  "title": "API MK Octadesk",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "tags": ["mk-octadesk"],
  "panels": [
    {
      "id": 1,
      "title": "Requisições por rota (req/s)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheusds" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(mk_octadesk_http_requests_total[5m])) by (route)",
          "legendFormat": "{{route}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Erros HTTP 5xx por rota (req/s)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheusds" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": { "color": { "mode": "fixed", "fixedColor": "red" } },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(mk_octadesk_http_requests_total{status=~\"5..\"}[5m])) by (route)",
          "legendFormat": "{{route}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Latência p95 por rota (s)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheusds" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(mk_octadesk_http_request_duration_seconds_bucket[5m])) by (le, route))",
          "legendFormat": "{{route}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Requisições em andamento",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheusds" },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "mk_octadesk_http_in_flight_requests",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "API up",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheusds" },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" } } },
            { "type": "value", "options": { "1": { "text": "UP", "color": "green" } } }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "up{job=\"api-mk-octadesk\"}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Erros do MK por código (req/s)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheusds" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "sum(rate(mk_octadesk_mk_errors_total[5m])) by (route, codigo)",
          "legendFormat": "{{route}} / {{codigo}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "Total de requisições (janela visível)",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheusds" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        {
          "expr": "sum(increase(mk_octadesk_http_requests_total[1h]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "title": "Total de requisições por rota (período selecionado)",
      "type": "bargauge",
      "datasource": { "type": "prometheus", "uid": "prometheusds" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 24 },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "targets": [
        {
          "expr": "sum(increase(mk_octadesk_http_requests_total{route=~\"/v1/.*\"}[$__range])) by (route)",
          "legendFormat": "{{route}}",
          "refId": "A",
          "instant": true
        }
      ]
    },
    {
      "id": 9,
      "title": "Requisições — $route",
      "type": "timeseries",
      "repeat": "route",
      "repeatDirection": "h",
      "maxPerRow": 2,
      "datasource": { "type": "prometheus", "uid": "prometheusds" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 },
      "fieldConfig": {
        "defaults": {
          "custom": { "fillOpacity": 15 },
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(mk_octadesk_http_requests_total{route=\"$route\"}[5m])) by (status)",
          "legendFormat": "status {{status}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 10,
      "title": "Autodesbloqueio — desfechos (período selecionado)",
      "type": "piechart",
      "datasource": { "type": "prometheus", "uid": "prometheusds" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 100 },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "values": ["value", "percent"] },
        "displayLabels": ["percent"]
      },
      "targets": [
        {
          "expr": "sum(increase(mk_octadesk_autodesbloqueio_resultado_total[$__range])) by (resultado)",
          "legendFormat": "{{resultado}}",
          "refId": "A",
          "instant": true
        }
      ]
    },
    {
      "id": 11,
      "title": "Autodesbloqueio — repetições no mesmo mês (req/s)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheusds" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 100 },
      "fieldConfig": {
        "defaults": { "color": { "mode": "fixed", "fixedColor": "orange" } },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(mk_octadesk_autodesbloqueio_resultado_total{resultado=\"limite_mensal_atingido\"}[15m]))",
          "legendFormat": "clientes tentando repetir",
          "refId": "A"
        }
      ]
    },
    {
      "id": 12,
      "title": "Classificação LLM — destino (período selecionado)",
      "type": "piechart",
      "datasource": { "type": "prometheus", "uid": "prometheusds" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 108 },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "values": ["value", "percent"] },
        "displayLabels": ["percent"]
      },
      "targets": [
        {
          "expr": "sum(increase(mk_octadesk_llm_classificacao_total[$__range])) by (destino)",
          "legendFormat": "{{destino}}",
          "refId": "A",
          "instant": true
        }
      ]
    },
    {
      "id": 13,
      "title": "Classificação LLM — erros por código (req/s)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheusds" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 108 },
      "fieldConfig": {
        "defaults": { "color": { "mode": "fixed", "fixedColor": "red" } },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(mk_octadesk_llm_erros_total[5m])) by (codigo)",
          "legendFormat": "{{codigo}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 14,
      "title": "Classificação LLM — latência p95 (s)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheusds" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 116 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(mk_octadesk_http_request_duration_seconds_bucket{route=\"/v1/llm-classifica-mensagem\"}[5m])) by (le))",
          "legendFormat": "p95",
          "refId": "A"
        }
      ]
    }
  ],
  "templating": {
    "list": [
      {
        "name": "route",
        "label": "Rota",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheusds" },
        "query": {
          "qryType": 1,
          "query": "label_values(mk_octadesk_http_requests_total{route=~\"/v1/.*\"}, route)",
          "refId": "route-variable"
        },
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "current": { "text": "All", "value": "$__all" },
        "sort": 1
      }
    ]
  }
}
