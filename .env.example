HTTP_PORT=8080

# Chave que o chatbot (Octadesk) deve enviar no header X-API-Key. Mínimo 24 caracteres.
CHATBOT_API_KEY=

MK_BASE_URL=https://sac.newlifefibra.com.br
MK_SERVICE_CODE=9999

# Credenciais do perfil de Webservice no MK (nunca commitar valores reais).
MK_USER_ACCESS_TOKEN=
MK_WEBSERVICE_COUNTER_PASSWORD=

# Alternativa às duas variáveis acima: um token temporário já emitido (uso pontual/teste).
# MK_TEMPORARY_AUTH_TOKEN=

MK_HTTP_TIMEOUT=10s
MK_TEMPORARY_AUTH_TOKEN_TTL=5m

# Só defina como true se o MK_BASE_URL realmente precisar ser http:// (não deveria).
# MK_ALLOW_INSECURE_HTTP=false

# Classificação de mensagens via LLM (Cloudflare Workers AI), rota
# /v1/llm-cf-classifica-mensagem. Obrigatórias — sem elas a API não sobe.
# Token precisa da permissão "Workers AI - Read" (o passo a passo de criação
# está no README.md).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AI_BASE_URL=https://api.cloudflare.com/client/v4/
CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.1-8b-instruct-fp8-fast
CLOUDFLARE_HTTP_TIMEOUT=45s
